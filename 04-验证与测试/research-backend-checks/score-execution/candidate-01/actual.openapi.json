        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "budget": {
            "pattern": "^(?:0|[1-9][0-9]{0,7})(?:\\.[0-9]{1,12})?$",
            "title": "Budget",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "budget"
        ],
        "title": "ScoreJobRequest",
        "type": "object"
      },
      "ShadowRequest": {
        "additionalProperties": false,
