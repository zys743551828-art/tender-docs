                          "text": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "source_reference"
                          },
                          "document_version_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "source_bid_id": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "type",
                          "document_version_id",
                          "source_bid_id"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "created_by": {
                  "type": "string",
                  "format": "uuid"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "recorded": {
                  "const": true
                },
                "assistant_operation_id": {
                  "type": "null"
                },
                "formal_scoring_input": {
                  "const": false
                }
              },
              "required": [
                "id",
                "bid_id",
                "conversation_id",
                "client_message_id",
                "role",
                "parts",
                "created_by",
                "created_at",
                "recorded",
                "assistant_operation_id",
                "formal_scoring_input"
              ],
              "additionalProperties": false
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "before": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "items",
          "has_more",
          "before"
        ],
        "additionalProperties": false
      }
    }
  }
}
