      },
      "put": {
        "tags": [
          "task templates"
        ],
        "summary": "Revise Template",
        "operationId": "revise_template_api_v1_bids__bid_id__task_definitions__definition_id__put",
        "parameters": [
          {
            "name": "bid_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Bid Id"
            }
          },
          {
            "name": "definition_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
