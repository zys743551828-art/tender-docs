  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkMessageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_message_id",
          "text",
          "source_version_ids"
        ],
        "properties": {
          "client_message_id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "pattern": "\\S"
          },
          "source_version_ids": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "WorkConversationStateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "active",
              "closed",
              "hidden"
            ]
          }
        }
      },
      "WorkConversationView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bid_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "active",
              "closed",
              "hidden"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "const": "project"
          },
          "is_main": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "stream_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "bid_id",
          "state",
          "revision",
          "created_at",
          "scope",
          "is_main",
          "title",
          "stream_id"
        ],
        "additionalProperties": false
      },
      "WorkMessageView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bid_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_message_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "enum": [
              "user",
              "assistant",
              "tool"
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "source_reference"
                    },
                    "document_version_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "source_bid_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "type",
                    "document_version_id",
                    "source_bid_id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "created_by": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "recorded": {
            "const": true
          },
          "assistant_operation_id": {
            "type": "null"
          },
          "formal_scoring_input": {
            "const": false
          }
        },
        "required": [
          "id",
          "bid_id",
          "conversation_id",
          "client_message_id",
          "role",
          "parts",
          "created_by",
          "created_at",
          "recorded",
          "assistant_operation_id",
          "formal_scoring_input"
        ],
        "additionalProperties": false
      },
