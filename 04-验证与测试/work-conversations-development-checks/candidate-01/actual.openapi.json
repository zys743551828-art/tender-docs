        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "bid_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "conversation_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "client_message_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "role": {
                  "enum": [
                    "user",
                    "assistant",
                    "tool"
